// ────────────── Input Configuration ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input

input {
    keyboard {
        xkb {
            layout "latam,us"
            options "grp:alt_shift_toggle"
        }
        numlock
        repeat-delay 250
        repeat-rate 50
    }

    touchpad {
        tap
        tap-button-map "left-right-middle"
        natural-scroll
        accel-profile "flat"
        click-method "clickfinger"
    }

    mouse {
        accel-profile "flat"
    }

    mod-key "Super"
    mod-key-nested "Alt"

    focus-follows-mouse
    workspace-auto-back-and-forth
}