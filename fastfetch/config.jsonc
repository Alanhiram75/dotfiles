{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/cl2.png",
        "width": 23,
        "height": 8,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 4
        }
    },

    "display": {
        "separator": "  ➜  ",
        "key": {
            "width": 10
        }
    },

    "modules": [
        "break",
        {
            "type": "os",
            "key": "OS",
            "keyColor": "32"
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "32"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ├ 󰏖 ",
            "keyColor": "32"
        },
        {
            "type": "shell",
            "key": " ├ 󰞷 ",
            "keyColor": "32"
        },
        {
            "type": "wm",
            "key": " ├ 󱂬 ",
            "keyColor": "32"
        },
        {
            "type": "terminal",
            "key": " ├ 󰄛 ",
            "keyColor": "32"
        },
        {
            "type": "memory",
            "key": " ├ 󰍛 ",
            "keyColor": "32"
        },
        {
            "type": "command",
            "key": " └ 󰅐 ",
            "keyColor": "32",
            "text": "echo $(( ($(date +%s) - $(date -d '2026-02-15' +%s)) / 86400 )) days"
        },
        "break"
    ]
}
