{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "arch_small",
        "padding": {
            "top": 1,
            "bottom": 1,
            "right": 1
        }
    },

    "display": {
        "separator": " ➜ ",
        "key": {
            "width": 0
        }
    },

    "modules": [
        "break",
        {
            "type": "os",
            "key": "Hp",
            "keyColor": "#7ca28b",
            "outputColor": "#d5e6d6"
        },
        {
            "type": "kernel",
            "key": " ├ 󰌽 ",
            "keyColor": "#7ca28b"
        },

        {
            "type": "shell",
            "key": " ├ 󰞷 ",
            "keyColor": "#7ca28b"
        },
        {
            "type": "wm",
            "key": " ├ 󱂬 ",
            "keyColor": "#7ca28b"
        },
        {
            "type": "terminal",
            "key": " ├ 󰄛 ",
            "keyColor": "#7ca28b"
        },
        {
            "type": "memory",
            "key": " ├ 󰍛 ",
            "keyColor": "#7ca28b"
        },
        {
            "type": "command",
            "key": " └ 󰅐 ",
            "keyColor": "#7ca28b",
            "text": "echo $(( ($(date +%s) - $(date -d '2026-02-15' +%s)) / 86400 )) days"
        },
        "break"
    ]
}
